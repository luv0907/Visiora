# VISIORA Backend — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit the .env file with real secrets.

# ── Core ──────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── LLM (Gemini Flash — default) ──────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# ── TTS (local Qwen3-TTS) ──────────────────────────────────────────
# Start your local TTS server first, then set the URL
QWEN_TTS_BASE_URL=http://localhost:8020
QWEN_TTS_API_KEY=

# ── Firebase ───────────────────────────────────────────────────────
# Option 1: Service account JSON file path (local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccount.json
# Option 2: Project ID only (for GCP/Cloud Run with ADC)
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Development:
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Production (update to your actual domain):
# ALLOWED_ORIGINS=["https://visiora.vercel.app"]

# ── Rate Limiting ──────────────────────────────────────────────────
RATE_LIMIT_AI_REQUESTS=20
RATE_LIMIT_AI_WINDOW_SECS=60
RATE_LIMIT_GLOBAL=100

# ── Cost Caps ──────────────────────────────────────────────────────
LLM_DAILY_TOKEN_CAP=500000
LLM_MONTHLY_TOKEN_CAP=10000000

# ── JWT (if using local auth as fallback) ─────────────────────────
JWT_SECRET=replace_with_a_strong_random_secret_in_production
