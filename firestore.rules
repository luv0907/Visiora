rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Validate that all incoming fields are within the allowed set
    function onlyFields(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    // A class code is optional, and when present a short string
    function validClassCode() {
      return !('classCode' in request.resource.data)
        || (request.resource.data.classCode is string && request.resource.data.classCode.size() <= 32);
    }

    // ── User profiles ────────────────────────────────────────────────────────
    // Users can read their own profile and set only their class code.
    // Mastery and quiz scores are written by the backend (Admin SDK, which these rules
    // don't apply to) after it has marked the answers, so no student can award themselves marks.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && onlyFields(['uid', 'classCode', 'createdAt'])
        && request.resource.data.uid == uid
        && validClassCode();
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classCode'])
        && validClassCode();
      allow delete: if false; // No self-delete in v1

      // Quiz history: backend only, and records never change
      match /quiz_history/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ── System / token budget ────────────────────────────────────────────────
    // Only the backend service account may write to the daily budget counters.
    // No client should ever have write access to this path.
    match /system/{document=**} {
      allow read: if false;   // Backend only via Admin SDK
      allow write: if false;  // Backend only via Admin SDK
    }

    // ── Catch-all: deny everything else ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
